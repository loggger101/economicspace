# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# Pipeline output — the whole tree lives under output_dir, which defaults to
# ./asteroid_pipeline outside Colab. Everything in it is regenerated per run.
/asteroid_pipeline/
*.parquet

# verify.py baselines — local reference runs, regenerated per release
/.verify/

# build_master.py syntax-check temp file
.master_check.pyc

# Dashboard launcher logs - the server's stdout, kept so a failed
# start is diagnosable when there is no console to have watched.
/.launcher/

# Local tooling / editor
.claude/
.ipynb_checkpoints/
.vscode/
.idea/

# OS / Google Drive artifacts
desktop.ini
Thumbs.db
.DS_Store

# Campaign cell archives - one gzipped full-catalog profitability catalog per
# cell, ~350-500 MB each and 8.1 GB for the 20-cell matrix. The measurements
# taken from them live in campaign/results.csv and campaign/FINDINGS.md, which
# ARE committed; the archives themselves are regenerable by re-running the cell.
/campaign/cells/
