# The pipeline sources are LF on disk and are pasted into Colab / Jupyter,
# which expect LF.  Pin it so a checkout on Windows (where core.autocrlf is
# often true, it is set in Git for Windows' system config by default) does
# not rewrite every file to CRLF.
*.py    text eol=lf
*.ipynb text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Shell scripts and git hooks MUST be LF.  core.autocrlf is true on this
# machine and in Git for Windows' system config, so without this a fresh
# clone checks the hooks out with CRLF and `#!/bin/sh` fails with
# "bad interpreter: No such file or directory" -- silently, because a failing
# hook is easy to miss.  These are the hooks that repair the Drive stat cache,
# so the failure mode is the phantom-dirty tree they exist to prevent.
*.sh         text eol=lf
.githooks/*  text eol=lf

# Same rule, and for the Dockerfile it is not cosmetic: a CRLF line
# ending after a backslash continuation puts the CR into the argument,
# so a multi-line RUN breaks on the build host.  The JSON is the
# platform probe's reference, read on both platforms.
Dockerfile   text eol=lf
*.json       text eol=lf

# Batch files are CRLF by convention, and this one is all labels, goto and
# call -- which is exactly where an LF-only .bat is known to misbehave.
*.bat   text eol=crlf

# Windows Script Host refuses to be flexible about line endings in a
# way nobody has ever fully documented; CRLF is what wscript expects.
*.vbs   text eol=crlf

# Machine-generated: the four modules concatenated by build_master.py, and by
# a wide margin the largest file here.  Marking it linguist-generated keeps it
# out of diff noise on hosts that understand the attribute.  No line count is
# quoted, deliberately: the one that used to be here read 6,300 against a file
# of 17,747, and nothing checks this file.
master.py linguist-generated=true
